---
import AlbumSection from "@components/organisms/AlbumSection.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { scanVisibleAlbums, toAlbumIndexItem } from "@utils/album-scanner";
import type { WallPhoto } from "@/types/album";

const visibleAlbums = scanVisibleAlbums();
const albums = visibleAlbums.map(toAlbumIndexItem);

// 「所有图片」视图：全部未加密相册的照片平铺（加密相册不参与）
const allPhotos: WallPhoto[] = visibleAlbums
	.filter((album) => !album.password)
	.flatMap((album) =>
		album.photos.map((photo) => ({
			...photo,
			album: album.title,
			albumId: album.id,
		})),
	);
---

<MainGridLayout title={i18n(I18nKey.albums)} description={i18n(I18nKey.albumsBanner)} page="albums">
	<AlbumSection {albums} photos={allPhotos} client:visible />
</MainGridLayout>
